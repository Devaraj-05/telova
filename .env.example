# Local development defaults for the FastAPI backend and Next.js frontend.
# Copy this file to `.env` for laptop development.
# Keep OAuth/service-account JSON files out of git. The `secrets/` folder is ignored.

APP_NAME=Telova API
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./telova.db
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FRONTEND_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

INTEGRATION_BACKEND=google
AGENT_RUNTIME=deterministic
AUTO_RESOLVE_CONFLICTS=false
PROGRESS_DEVIATION_THRESHOLD=0.20
DEFAULT_USER_ID=demo-user

GCP_PROJECT_ID=
GCP_REGION=us-central1
USE_SECRET_MANAGER=false

ALLOYDB_INSTANCE_NAME=
ALLOYDB_DATABASE=
ALLOYDB_USER=
ALLOYDB_PASSWORD=
ALLOYDB_PASSWORD_SECRET=
ALLOYDB_REFRESH_STRATEGY=lazy
ALLOYDB_IP_TYPE=
ALLOYDB_ENABLE_IAM_AUTH=false
ALLOYDB_AI_NL_ENABLED=false
ALLOYDB_AI_NL_CONFIG_ID=telova_nl

GOOGLE_WORKSPACE_AUTH_MODE=disabled
GOOGLE_WORKSPACE_SUBJECT=
GOOGLE_WORKSPACE_AUTHORIZED_USER_JSON=
GOOGLE_WORKSPACE_AUTHORIZED_USER_JSON_FILE=
GOOGLE_WORKSPACE_AUTHORIZED_USER_SECRET=
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_CLIENT_JSON_FILE=./secrets/google-web-client.json
GOOGLE_OAUTH_CLIENT_JSON_SECRET=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON_FILE=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_TASKLIST_ID=
GOOGLE_KEEP_ENABLED=false

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=

ADK_MODEL=gemini-2.5-flash
ADK_APP_NAME=telova

API_AUTH_MODE=disabled
AUTH_TOKEN_SECRET=replace-this-with-a-long-random-secret
AUTH_TOKEN_TTL_MINUTES=10080
API_KEY=
API_KEY_SECRET=
CRON_SHARED_TOKEN=
CRON_SHARED_TOKEN_SECRET=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
JSON_LOGS=true
ENABLE_ACCESS_LOGS=true
SENTRY_DSN=

CLOUD_RUN_SERVICE_URL=
CLOUD_SCHEDULER_LOCATION=
CLOUD_SCHEDULER_SERVICE_ACCOUNT=
CRON_CONFLICT_SCAN_SCHEDULE=
CRON_WEEKLY_REVIEW_SCHEDULE=
