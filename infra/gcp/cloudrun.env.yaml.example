# ─── Cloud Run Environment Variables ─────────────────────────────────────────
# Copy this to cloudrun.env.yaml and fill in your values.
# Used by: gcloud run deploy --env-vars-file cloudrun.env.yaml
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME: Telova API
APP_ENV: production
APP_TIMEZONE: Asia/Kolkata

# Database — use AlloyDB for production
# DATABASE_URL: postgresql+asyncpg://user:pass@/telova?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL: sqlite+aiosqlite:///./telova.db

# AlloyDB (if using connector instead of DATABASE_URL)
# ALLOYDB_INSTANCE_NAME: projects/PROJECT_ID/locations/REGION/clusters/CLUSTER/instances/INSTANCE
# ALLOYDB_DATABASE: telova
# ALLOYDB_USER: telova-app
# ALLOYDB_PASSWORD_SECRET: telova-alloydb-password
# ALLOYDB_ENABLE_IAM_AUTH: false

# Google Cloud
GOOGLE_CLOUD_PROJECT: telova-492406
GOOGLE_CLOUD_LOCATION: us-central1
GOOGLE_GENAI_USE_VERTEXAI: "true"
ADK_MODEL: gemini-2.5-flash
ADK_APP_NAME: telova

# Runtime
AGENT_RUNTIME: deterministic
INTEGRATION_BACKEND: google
AUTO_RESOLVE_CONFLICTS: "false"
PROGRESS_DEVIATION_THRESHOLD: "0.20"
DEFAULT_USER_ID: demo-user

# Auth
API_AUTH_MODE: disabled
AUTH_TOKEN_SECRET: CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Rate limiting
RATE_LIMIT_ENABLED: "true"
RATE_LIMIT_REQUESTS: "120"
RATE_LIMIT_WINDOW_SECONDS: "60"

# Logging
JSON_LOGS: "true"
ENABLE_ACCESS_LOGS: "true"

# CORS — updated automatically by deploy.sh
CORS_ALLOW_ORIGINS: http://localhost:3000
FRONTEND_APP_URL: http://localhost:3000

# Secret Manager
USE_SECRET_MANAGER: "false"
# GCP_PROJECT_ID: telova-492406

# Google OAuth (for Calendar/Tasks sync)
# GOOGLE_OAUTH_CLIENT_JSON_SECRET: telova-oauth-client
GOOGLE_WORKSPACE_AUTH_MODE: disabled

# AlloyDB AI Natural Language
ALLOYDB_AI_NL_ENABLED: "false"
# ALLOYDB_AI_NL_CONFIG_ID: telova_nl
